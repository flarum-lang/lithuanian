{
	"name": "flarum-lang/lithuanian",
	"description": "Lithuanian Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/lithuanian",
	"license": "MIT",
	"support": {
		"issues": "https://github.com/flarum-lang/lithuanian/issues",
		"forum": "https://discuss.flarum.org/d/30283",
		"source": "https://github.com/flarum-lang/lithuanian"
	},
	"require": {
		"flarum/core": "^1.0.0"
	},
	"extra": {
		"branch-alias": {
			"dev-main": "1.x-dev"
		},
		"flarum-extension": {
			"title": "Lithuanian",
			"category": "language",
			"icon": {
				"image": "icon.svg",
				"backgroundColor": "#00247d",
				"backgroundSize": "cover",
				"backgroundPosition": "center"
			}
		},
		"flarum-locale": {
			"code": "lt",
			"title": "Lietuvių"
		}
	}
}
